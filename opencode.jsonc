{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "command": ["npx", "-y", "pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "instructions": ["AGENTS.md"]
}
